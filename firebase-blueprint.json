{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Root workspace configuration, profile, settings, and daily routine completion map owned by a single Firebase user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "onboarded": { "type": "boolean" },
        "migratedFromLocal": { "type": "boolean" },
        "profile": { "type": "object" },
        "settings": { "type": "object" },
        "routineCompletions": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "onboarded", "profile", "settings", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A personal, academic, or project task belonging to a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 64 },
        "projectId": { "type": "string", "maxLength": 128 },
        "startDate": { "type": "string", "maxLength": 20 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "deadlineTime": { "type": "string", "maxLength": 10 },
        "priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "status": { "type": "string", "enum": ["Not Started", "In Progress", "Completed", "On Hold"] },
        "estimatedMinutes": { "type": "number" },
        "actualMinutes": { "type": "number" },
        "subtasks": { "type": "array" },
        "notes": { "type": "string", "maxLength": 5000 },
        "tags": { "type": "array" },
        "attachments": { "type": "array" },
        "recurrence": { "type": "string", "enum": ["None", "Daily", "Weekly", "Monthly"] },
        "reminderTiming": { "type": "string", "enum": ["none", "0d", "1d", "3d", "7d"] },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 },
        "completedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "title", "priority", "status"]
    },
    "Project": {
      "title": "Project",
      "description": "A multi-step project with milestones and notes belonging to a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "startDate": { "type": "string", "maxLength": 20 },
        "expectedEndDate": { "type": "string", "maxLength": 20 },
        "priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "status": { "type": "string", "enum": ["Planning", "Active", "On Hold", "Completed"] },
        "notes": { "type": "string", "maxLength": 5000 },
        "milestones": { "type": "array" },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "title", "priority", "status"]
    },
    "Subject": {
      "title": "Subject",
      "description": "An academic course/subject with chapters and syllabus completion tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "code": { "type": "string", "maxLength": 40 },
        "faculty": { "type": "string", "maxLength": 120 },
        "semester": { "type": "string", "maxLength": 60 },
        "chapters": { "type": "array" },
        "syllabusCompletion": { "type": "number" },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "name"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "An academic assignment linked optionally to a subject.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 4000 },
        "assignedDate": { "type": "string", "maxLength": 20 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["Pending", "In Progress", "Submitted", "Graded"] },
        "priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "notes": { "type": "string", "maxLength": 4000 },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "title", "status", "priority"]
    },
    "Exam": {
      "title": "Exam",
      "description": "An examination schedule with preparation topics and revision dates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "examDate": { "type": "string", "maxLength": 20 },
        "examTime": { "type": "string", "maxLength": 10 },
        "topics": { "type": "array" },
        "preparationStatus": { "type": "string", "enum": ["Not Started", "Preparing", "Revision", "Ready"] },
        "revisionDates": { "type": "array" },
        "notes": { "type": "string", "maxLength": 4000 },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "name", "preparationStatus"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "A logged study block for academic tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 20 },
        "durationMinutes": { "type": "number" },
        "topic": { "type": "string", "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 2000 },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "date", "durationMinutes"]
    },
    "RoutineSlot": {
      "title": "RoutineSlot",
      "description": "A daily routine time slot in the planner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "maxLength": 64 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "dayScope": { "type": "string", "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 1000 },
        "isSample": { "type": "boolean" }
      },
      "required": ["id", "ownerUid", "title", "startTime", "endTime"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "A personal calendar event.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "date": { "type": "string", "maxLength": 20 },
        "time": { "type": "string", "maxLength": 10 },
        "category": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 2000 },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "title", "date"]
    },
    "Note": {
      "title": "Note",
      "description": "A personal, academic, or project note.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content": { "type": "string", "maxLength": 20000 },
        "category": { "type": "string", "maxLength": 64 },
        "tags": { "type": "array" },
        "pinned": { "type": "boolean" },
        "isSample": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "title"]
    },
    "Activity": {
      "title": "Activity",
      "description": "A user workspace activity log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": { "type": "string", "minLength": 1, "maxLength": 120 },
        "detail": { "type": "string", "maxLength": 500 },
        "entityType": { "type": "string", "maxLength": 40 },
        "timestamp": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "ownerUid", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Private user workspace metadata, profile, settings, and daily routine completion map."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks owned by the user."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects owned by the user."
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Academic subjects owned by the user."
    },
    "/users/{userId}/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Academic assignments owned by the user."
    },
    "/users/{userId}/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Academic examinations owned by the user."
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "Study sessions logged by the user."
    },
    "/users/{userId}/routineSlots/{slotId}": {
      "schema": { "$ref": "#/entities/RoutineSlot" },
      "description": "Daily planner routine time slots owned by the user."
    },
    "/users/{userId}/calendarEvents/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "Personal calendar events owned by the user."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Personal notes owned by the user."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "Activity history entries owned by the user."
    }
  }
}
